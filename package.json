{
  "name": "dsh-agent-team-fix",
  "version": "0.4.0",
  "description": "Recommend routine- and difficult-task models from the official DSH subagent allowlist.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/NULLCOLORcat/dsh-Smarter-Subagent-level.git" },
  "type": "module",
  "main": "./index.js",
  "exports": { ".": "./index.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./package.json": "./package.json" },
  "files": ["index.js", "runtime.js", "routing.js", "client.js", "locale", "cordis.patch.yml", "README.md"],
  "engines": { "dsh": "0.2.2-rc.5" },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.19.0 <4"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-plugin-manager"],
      "platform": "web"
    }
  },
  "scripts": { "test": "node --test test.mjs test-client.mjs test-bootstrap.mjs" }
}
