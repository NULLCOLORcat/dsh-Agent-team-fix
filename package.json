{
  "name": "dsh-agent-team-fix",
  "version": "0.3.0",
  "description": "Route DSH teammates to daily-task models or optional higher-cost models for difficult work.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/NULLCOLORcat/dsh-Agent-team-fix.git" },
  "type": "module",
  "main": "./index.js",
  "exports": { ".": "./index.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./package.json": "./package.json" },
  "files": ["index.js", "runtime.js", "routing.js", "client.js", "locale", "cordis.patch.yml", "README.md"],
  "engines": { "dsh": "0.2.2-rc.5" },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.19.0 <4",
    "@deepseek-ai/dsh-agent-team": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-plugin-manager", "@deepseek-ai/dsh-api-remotes"],
      "platform": "web"
    }
  },
  "scripts": { "test": "node --test test.mjs test-client.mjs" }
}
